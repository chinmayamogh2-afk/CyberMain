# ─────────────────────────────────────────────────────────────────────────────
# SentinelX — example environment file
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored and must never be committed (spec §31).
#
# Generate each secret below with:          openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Where the React app runs. Used for CORS allow-listing and CSRF origin checks.
FRONTEND_ORIGIN=http://localhost:5173

# SentinelX's own base URL. The security scanner probes THIS address only.
# Keep it loopback — the platform must never be pointed at a third party (§41).
SELF_BASE_URL=http://127.0.0.1:4000

# ── Database ────────────────────────────────────────────────────────────────
# sqlite   → zero setup, default, used for local demos
# postgres → requires DATABASE_URL, provided by docker compose
DB_DRIVER=sqlite
# DATABASE_URL=postgres://sentinelx:sentinelx@localhost:5432/sentinelx

# ── Secrets ─────────────────────────────────────────────────────────────────
# HMAC key used to sign session identifiers.
SESSION_SECRET=replace-me-with-openssl-rand-hex-32

# HMAC key for CSRF tokens. Intentionally separate from SESSION_SECRET so that
# disclosure of one does not defeat the other.
CSRF_SECRET=replace-me-with-a-different-openssl-rand-hex-32

# AES-256-GCM key for encrypting sensitive columns at rest.
# MUST decode to exactly 32 bytes. Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=replace-me-with-exactly-32-bytes-hex

# ── Behaviour ───────────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=60
MAX_UPLOAD_BYTES=5242880
SCRYPT_COST=16384

# Creates the demo accounts (alice/bob/analyst/admin) used by Demo Mode.
# Set to false for any non-demo deployment.
ENABLE_DEMO_SEED=true
